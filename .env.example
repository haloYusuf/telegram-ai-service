# ==============================================================================
# TELEGRAM SERVICE - ENVIRONMENT EXAMPLE TEMPLATE (.env.example)
# ==============================================================================

# Server Port
SERVER_PORT=8085

# Security API Key (X-API-KEY header / apiKey query parameter)
API_KEY=your-secret-api-key-here

# MongoDB Database Credentials
MONGODB_URI=mongodb://{username}:{password}@localhost:27018/{dbname}?authSource=admin
MONGODB_HOST=localhost
MONGODB_PORT=27018
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=telegram_service_db
MONGODB_AUTH_SOURCE=admin

# Redis Cache & PubSub Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=5000ms

# Telegram API & Webhook Configuration
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_BASE_URL=https://your-domain.com

# Google Gemini Multimodal AI Credentials
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# MinIO Object Storage Credentials
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=telegram-media

# Agentic AI Debounce Buffer (Seconds)
AGENTIC_BUFFER_TTL_SECONDS=5
